@using Dropblog.Services
@inject IBlogConfigurationService BlogConfig
@implements IDisposable

<div class="desktop-nav">
    <div class="brand">
        <Icon Name="pen" Size="18" />
        <span>Dropblog</span>
    </div>

    <nav class="desktop-links">
        <NavLink class="desktop-link" href="" Match="NavLinkMatch.All">
            <Icon Name="pen" />
            <span>New Post</span>
        </NavLink>
        <NavLink class="desktop-link" href="blog-management">
            <Icon Name="blogs" />
            <span>Blogs</span>
        </NavLink>
        @if (HasBlog)
        {
            <a class="desktop-link" href="@BlogConfig.CurrentBlogSite.Url" target="_blank">
                <Icon Name="external" />
                <span>View Blog</span>
            </a>
        }
    </nav>
</div>

<nav class="mobile-nav">
    <NavLink class="mobile-link" href="" Match="NavLinkMatch.All">
        <Icon Name="pen" Size="22" />
        <span>Write</span>
    </NavLink>
    <NavLink class="mobile-link" href="blog-management">
        <Icon Name="blogs" Size="22" />
        <span>Blogs</span>
    </NavLink>
    @if (HasBlog)
    {
        <a class="mobile-link" href="@BlogConfig.CurrentBlogSite.Url" target="_blank">
            <Icon Name="external" Size="22" />
            <span>View Blog</span>
        </a>
    }
    else
    {
        <span class="mobile-link disabled">
            <Icon Name="external" Size="22" />
            <span>View Blog</span>
        </span>
    }
</nav>

@code {
    private bool HasBlog => BlogConfig.CurrentBlogSite != BlogSite.Empty;

    protected override async Task OnInitializedAsync()
    {
        await BlogConfig.LoadBlogSitesAsync();
        BlogConfig.CurrentBlogSiteChanged += OnCurrentBlogSiteChanged;
    }

    private void OnCurrentBlogSiteChanged(object? sender, BlogSite newSite)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        BlogConfig.CurrentBlogSiteChanged -= OnCurrentBlogSiteChanged;
    }
}
