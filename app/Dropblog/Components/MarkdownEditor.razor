@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<div class="markdown-editor">
    <div class="toolbar">
        <button type="button" class="btn btn-sm" @onclick="@(() => InsertMarkdownAsync("**", "**"))" title="Bold">
            <strong>B</strong>
        </button>
        <button type="button" class="btn btn-sm" @onclick="@(() => InsertMarkdownAsync("*", "*"))" title="Italic">
            <em>I</em>
        </button>
        <button type="button" class="btn btn-sm" @onclick="@(() => InsertMarkdownAsync("<u>", "</u>"))" title="Underline">
            <u>U</u>
        </button>
        <button type="button" class="btn btn-sm" @onclick="@(() => InsertCodeAsync(false))" title="Inline Code">
            <code>`c`</code>
        </button>
        <button type="button" class="btn btn-sm" @onclick="@(() => InsertCodeAsync(true))" title="Code Block">
            <Icon Name="code" Size="16" />
        </button>
        <button type="button" class="btn btn-sm" @onclick="ToggleListAsync" title="Toggle List">
            <Icon Name="list" Size="16" />
        </button>
        <button type="button" class="btn btn-sm" @onclick="@(() => InsertMarkdownAsync("[link text](url)", ""))" title="Link">
            <Icon Name="link" Size="16" />
        </button>
    </div>
    <textarea id="@textareaId"
              @bind="text"
              @bind:event="oninput"
              @bind:after="NotifyAsync"
              class="form-control editor-textarea" 
              placeholder="Write your post in Markdown..."
              rows="16"></textarea>
</div>

@code {
    private readonly string textareaId = Guid.NewGuid().ToString();

    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private string text = string.Empty;
    private string lastSent = string.Empty;

    // Only take Value from the parent when it changed there (cleared after posting, shared content);
    // echoing our own value back would overwrite characters typed in the meantime.
    protected override void OnParametersSet()
    {
        if (Value != lastSent)
        {
            text = Value;
            lastSent = Value;
        }
    }

    // Typing and the toolbar JS (which dispatches an input event) both end up here.
    private async Task NotifyAsync()
    {
        lastSent = text;
        await ValueChanged.InvokeAsync(text);
    }

    private Task InsertMarkdownAsync(string before, string after) =>
        RunToolbarAsync("markdownEditor.insertMarkdown", before + "text" + after, textareaId, before, after);

    private Task InsertCodeAsync(bool isBlock) =>
        RunToolbarAsync("markdownEditor.insertCode", isBlock ? "```\ncode\n```" : "`code`", textareaId, isBlock);

    private Task ToggleListAsync() =>
        RunToolbarAsync("markdownEditor.toggleList", "- ", textareaId);

    private async Task RunToolbarAsync(string function, string fallbackText, params object[] args)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync(function, args);
        }
        catch (JSException)
        {
            text += fallbackText;
            await NotifyAsync();
        }
    }
}
